<nav aria-label="<%= t(".label") %>" class="flex gap-3 text-sm">
  <% I18n.available_locales.each do |locale| %>
    <% if locale == I18n.locale %>
      <span class="font-semibold" lang="<%= locale %>"><%= t("locales.#{locale}") %></span>
    <% else %>
      <%# No hover prefetch: the request saves the locale cookie, so a prefetch would switch language without a click. %>
      <%= link_to t("locales.#{locale}"), url_for(request.query_parameters.merge(locale: locale)),
            lang: locale, data: { turbo_prefetch: false }, class: "text-muted underline decoration-lime-strong decoration-2 underline-offset-4 hover:text-ink" %>
    <% end %>
  <% end %>
</nav>
