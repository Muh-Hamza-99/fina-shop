<div class="flex items-start justify-between gap-4">
  <%= render "admin/shared/page_header", title: t(".title"), subtitle: t(".subtitle") %>
  <%= link_to t(".add"), new_admin_category_path, class: "btn-primary shrink-0" %>
</div>

<% if @categories.any? %>
  <ul class="divide-y divide-gray-200 rounded-md border border-gray-200 bg-white" id="categories">
    <%= render partial: "category", collection: @categories, locals: { depth: 1 } %>
  </ul>
<% else %>
  <div class="rounded-md border border-dashed border-gray-300 bg-white p-10 text-center">
    <p class="font-semibold"><%= t(".empty_title") %></p>
    <p class="mt-1 text-gray-600"><%= t(".empty_description") %></p>
  </div>
<% end %>
