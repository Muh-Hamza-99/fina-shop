<div class="flex items-start justify-between gap-4">
  <%= render "admin/shared/page_header", title: t(".title"), subtitle: t(".subtitle") %>
  <%= link_to t(".add"), new_admin_category_path, class: "btn-primary shrink-0" %>
</div>

<% if @categories.any? %>
  <ul class="divide-y divide-line overflow-hidden rounded-[20px] bg-white" id="categories">
    <%= render partial: "category", collection: @categories, locals: { depth: 1 } %>
  </ul>
<% else %>
  <div class="panel p-10 text-center">
    <p class="font-display text-lg font-bold"><%= t(".empty_title") %></p>
    <p class="mt-1 text-muted"><%= t(".empty_description") %></p>
  </div>
<% end %>
