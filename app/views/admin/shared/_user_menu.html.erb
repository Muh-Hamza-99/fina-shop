<%# Merchant info pinned to the bottom of the sidebar, with a dropdown of account actions. %>
<details class="relative border-t border-gray-200 p-3" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutsideClick keydown.esc@window->dropdown#close">
  <summary class="flex items-center gap-3 rounded-md px-2 py-2 cursor-pointer list-none hover:bg-gray-100 [&::-webkit-details-marker]:hidden"
           aria-label="<%= t("admin.layout.account_menu") %>">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-gray-900 text-sm font-semibold text-white" aria-hidden="true">
      <%= Current.user.name.first %>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-medium" id="current_user"><%= Current.user.name %></span>
      <span class="block truncate text-xs text-gray-500" dir="ltr"><%= Current.user.email_address %></span>
    </span>
    <svg class="size-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .55.24l3.25 3.5a.75.75 0 1 1-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 0 1-1.1-1.02l3.25-3.5A.75.75 0 0 1 10 3Zm-3.76 9.2a.75.75 0 0 1 1.06.04l2.7 2.908 2.7-2.908a.75.75 0 1 1 1.1 1.02l-3.25 3.5a.75.75 0 0 1-1.1 0l-3.25-3.5a.75.75 0 0 1 .04-1.06Z" clip-rule="evenodd" />
    </svg>
  </summary>

  <div class="absolute bottom-full inset-x-3 mb-1 rounded-md border border-gray-200 bg-white py-1 shadow-lg" role="menu">
    <%= button_to t("admin.layout.logout"), admin_session_path, method: :delete, role: "menuitem",
          class: "w-full px-4 py-2 text-start text-sm text-red-600 hover:bg-gray-50 cursor-pointer" %>
  </div>
</details>
