<% if alert = flash[:alert] %>
  <p class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 font-medium text-red-700" id="alert"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p class="mb-5 rounded-xl border border-lime-strong bg-lime-soft px-4 py-3 font-medium text-ink" id="notice"><%= notice %></p>
<% end %>
