<% content_for :title, t(".title") %>

<h1 class="text-3xl"><%= t(".title") %></h1>
<p class="mt-2 text-muted"><%= t(".subtitle") %></p>

<%= form_with model: @signup, url: admin_signup_path, scope: :signup, class: "contents" do |form| %>
  <h2 class="mt-8 text-xl font-semibold"><%= t(".store_info") %></h2>

  <%= render "admin/shared/field", form: form, field: :store_name_ar, label: t(".store_name_ar") do %>
    <%= form.text_field :store_name_ar, required: true, autofocus: true, dir: "rtl", class: "form-input" %>
  <% end %>

  <%= render "admin/shared/field", form: form, field: :store_name_en, label: t(".store_name_en") do %>
    <%= form.text_field :store_name_en, dir: "ltr", class: "form-input" %>
  <% end %>

  <div data-controller="subdomain-preview" data-subdomain-preview-template-value="<%= t(".subdomain_preview", url: "__url__") %>">
    <%= render "admin/shared/field", form: form, field: :subdomain, label: t(".subdomain"),
          hint: t(".subdomain_preview", url: "#{@signup.subdomain.presence || "…"}.#{Hosts.root_domain}"),
          hint_data: { subdomain_preview_target: "preview" } do %>
      <div class="flex items-center gap-2" dir="ltr">
        <%= form.text_field :subdomain, required: true, autocomplete: "off", autocapitalize: "none", spellcheck: false,
              minlength: 3, maxlength: 32, pattern: "[a-z0-9][a-z0-9\\-]{1,30}[a-z0-9]", class: "form-input",
              data: { subdomain_preview_target: "input", action: "input->subdomain-preview#update",
                      subdomain_preview_domain_param: Hosts.root_domain } %>
        <span class="mt-2 text-muted">.<%= Hosts.root_domain %></span>
      </div>
    <% end %>
  </div>

  <h2 class="mt-8 text-xl font-semibold"><%= t(".account_info") %></h2>

  <%= render "admin/shared/field", form: form, field: :name, label: t(".name") do %>
    <%= form.text_field :name, required: true, minlength: 2, autocomplete: "name", class: "form-input" %>
  <% end %>

  <%= render "admin/shared/field", form: form, field: :email_address, label: t(".email") do %>
    <%= form.email_field :email_address, required: true, autocomplete: "username", dir: "ltr", class: "form-input" %>
  <% end %>

  <%= render "admin/shared/field", form: form, field: :password, label: t(".password") do %>
    <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", dir: "ltr", class: "form-input" %>
  <% end %>

  <%= render "admin/shared/field", form: form, field: :password_confirmation, label: t(".password_confirmation") do %>
    <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", dir: "ltr", class: "form-input" %>
  <% end %>

  <div class="sm:flex sm:items-center sm:gap-4">
    <%= form.submit t(".submit"), class: "btn-primary" %>

    <div class="mt-4 text-sm text-muted sm:mt-0">
      <%= t(".have_account") %>
      <%= link_to t(".sign_in"), new_admin_session_path, class: "link-subtle" %>
    </div>
  </div>
<% end %>
