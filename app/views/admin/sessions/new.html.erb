<% content_for :title, t(".title") %>

<h1 class="text-3xl"><%= t(".title") %></h1>
<p class="mt-2 text-muted"><%= t(".subtitle") %></p>

<%= form_with url: admin_session_path, class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :email_address, t(".email") %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", dir: "ltr", value: params[:email_address], class: "form-input" %>
  </div>

  <div class="my-5">
    <%= form.label :password, t(".password") %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, dir: "ltr", class: "form-input" %>
  </div>

  <div class="sm:flex sm:items-center sm:gap-4">
    <%= form.submit t(".submit"), class: "btn-primary" %>

    <div class="mt-4 text-sm text-muted sm:mt-0">
      <%= link_to t(".forgot_password"), new_admin_password_path, class: "link-subtle" %>
    </div>
  </div>
<% end %>

<p class="mt-8 text-sm text-muted">
  <%= t(".no_account") %>
  <%= link_to t(".create_account"), admin_signup_path, class: "link-subtle" %>
</p>
